NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key

# Public site URL (Paystack callback + absolute links + SEO canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (Nigeria / local checkout)
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Flutterwave v4 checkout (Dashboard → Settings → API Keys)
FLUTTERWAVE_CLIENT_ID=your-client-id
FLUTTERWAVE_CLIENT_SECRET=your-client-secret
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key
FLUTTERWAVE_ENV=sandbox
# Optional webhook hash from Flutterwave dashboard → Webhooks
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-hash

# Resend transactional email (verify mykindofstyle.com in Resend dashboard)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=MKoS <hello@mykindofstyle.com>
ORDER_NOTIFY_EMAIL=styleme@mykindofstyle.com
# Absolute base for images in emails (must be the verified sending domain when possible)
EMAIL_ASSET_BASE_URL=https://mykindofstyle.com

# Google Analytics 4 (Admin → Data streams → Measurement ID, e.g. G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Google Search Console (Settings → Ownership verification → HTML tag content= value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token
